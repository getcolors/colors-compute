{:paths ["src/clj" "src/resources" "test/clj"]
 :deps {io.github.getcolors/colors-compute {:local/root "."}}
 :tasks {test {:requires ([clojure.test :as t]
                         [io.github.getcolors.compute-test]
                         [io.github.getcolors.compute-workflow-test]
                         [io.github.getcolors.compute-runtime-test]
                         [io.github.getcolors.compute-coordination-test]
                         [io.github.getcolors.compute-journal-test])
               :task (let [{:keys [fail error]} (t/run-tests 'io.github.getcolors.compute-test 'io.github.getcolors.compute-workflow-test 'io.github.getcolors.compute-runtime-test 'io.github.getcolors.compute-coordination-test 'io.github.getcolors.compute-journal-test)]
                       (System/exit (if (pos? (+ fail error)) 1 0)))}}}
