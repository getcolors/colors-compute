        "compute-prevent-destroy": true,
        "profile": "production",
        "provider-compute": "aws",
        "provider-backend": "s3",
        "s3-bucket": "compute-fixture",
        "s3-region": "eu-west-1",
        "s3-prefix": "infrastructure"
      },
      {
        "node_id": "app-0",
        "state_filename": "app-0.tfstate",
        "workdir": "/sdk",
        "security": {
          "egress": "all",
          "ingress": [
            {
              "from_port": 22,
              "id": "ssh",
              "protocol": "tcp",
              "sources": [
                "192.0.2.1/32"
              ],
              "to_port": 22
            },
            {
              "from_port": 9093,
              "id": "peer",
              "protocol": "tcp",
              "sources": [
                "private"
              ],
              "to_port": 9094
            }
          ],
          "private_filter": true
        },
        "network": {
          "cidr": "10.42.0.0/16",
          "mode": "created",
          "subnet_cidr": "10.42.1.0/24",
          "zone": "eu-central"
        }
