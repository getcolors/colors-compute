        "outbound_rules": [
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "port_range": "1-65535",
            "protocol": "tcp"
          },
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "port_range": "1-65535",
            "protocol": "udp"
          },
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "protocol": "icmp"
          }
        ],
        "prevent_destroy": true,
        "private_ingress": {
          "peer:private": {
            "port_range": "9093-9094",
            "protocol": "tcp"
          }
        },
        "profile": "example",
        "public_ingress": {
          "ssh:192.0.2.1/32": {
