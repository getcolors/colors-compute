[
  {
    "args": [
      {
        "compute-prevent-destroy": true,
        "digitalocean-image": "ubuntu-24-04-x64",
        "digitalocean-region": "nyc3",
        "digitalocean-size": "s-2vcpu-4gb",
        "profile": "example",
        "provider-compute": "digitalocean"
      },
      "shared",
      {
        "key": {
          "mode": "managed",
          "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
        },
        "name": "example-0",
        "network": {
          "cidr": "10.30.0.0/24",
          "mode": "created"
        },
        "node_id": "0",
        "security": {
          "egress": "all",
          "ingress": [
            {
              "from_port": 22,
              "id": "ssh",
              "protocol": "tcp",
              "sources": [
                "192.0.2.1/32"
              ],
              "to_port": 22
            },
            {
              "from_port": 9093,
              "id": "peer",
              "protocol": "tcp",
              "sources": [
                "private"
              ],
              "to_port": 9094
            }
          ],
          "private_filter": true
        }
      },
      {}
    ],
    "expected": {
      "documents": {
        "shared-created.tf.json": {
          "locals": {
            "private_ingress": {
              "peer:private": {
                "port_range": "9093-9094",
                "protocol": "tcp"
              }
            },
            "public_ingress": {
              "ssh:192.0.2.1/32": {
                "port_range": "22",
                "protocol": "tcp",
                "source_addresses": [
                  "192.0.2.1/32"
                ]
              }
            }
          },
          "output": {
            "params": {
              "value": {
                "deployment_tag": "${digitalocean_tag.deployment.name}",
                "endpoint_ip": "${try(digitalocean_reserved_ip.endpoint[0].ip_address, null)}",
                "firewall_id": "${digitalocean_firewall.network.id}",
                "network_cidr": "${digitalocean_vpc.network.ip_range}",
                "provider": "digitalocean",
                "vpc_id": "${digitalocean_vpc.network.id}",
                "vpc_ip_range": "${digitalocean_vpc.network.ip_range}"
              }
            }
          },
          "provider": {
            "digitalocean": {}
          },
          "resource": {
            "digitalocean_firewall": {
              "network": {
                "dynamic": {
                  "inbound_rule": [
                    {
                      "content": {
                        "port_range": "${try(inbound_rule.value.port_range, null)}",
                        "protocol": "${inbound_rule.value.protocol}",
                        "source_addresses": "${inbound_rule.value.source_addresses}"
                      },
                      "for_each": "${local.public_ingress}"
                    },
                    {
                      "content": {
                        "port_range": "${try(inbound_rule.value.port_range, null)}",
                        "protocol": "${inbound_rule.value.protocol}",
                        "source_addresses": [
                          "${digitalocean_vpc.network.ip_range}"
                        ]
                      },
                      "for_each": "${local.private_ingress}"
                    }
                  ]
                },
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "example-firewall",
                "outbound_rule": [
                  {
                    "destination_addresses": [
                      "0.0.0.0/0",
                      "::/0"
                    ],
                    "port_range": "1-65535",
                    "protocol": "tcp"
                  },
                  {
                    "destination_addresses": [
                      "0.0.0.0/0",
                      "::/0"
                    ],
                    "port_range": "1-65535",
                    "protocol": "udp"
                  },
                  {
                    "destination_addresses": [
                      "0.0.0.0/0",
                      "::/0"
                    ],
                    "protocol": "icmp"
                  }
                ],
                "tags": [
                  "${digitalocean_tag.deployment.name}"
                ]
              }
            },
            "digitalocean_reserved_ip": {
              "endpoint": {
                "count": 0,
                "lifecycle": {
                  "ignore_changes": [
                    "droplet_id"
                  ],
                  "prevent_destroy": true
                },
                "region": "nyc3"
              }
            },
            "digitalocean_tag": {
              "deployment": {
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "colors-compute-example"
              }
            },
            "digitalocean_vpc": {
              "network": {
                "ip_range": "10.30.0.0/24",
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "example-network",
                "region": "nyc3"
              }
            }
          },
          "terraform": {
            "required_providers": {
              "digitalocean": {
                "source": "digitalocean/digitalocean",
                "version": "2.51.0"
              }
            },
            "required_version": ">= 1.8.0"
          }
        },
        "shared-keygen.tf.json": {
          "output": {
            "registration": {
              "value": {
                "id": "${digitalocean_ssh_key.machine.id}",
                "provider": "digitalocean",
                "scope": "account"
              }
            },
            "ssh_key_id": {
              "value": "${digitalocean_ssh_key.machine.id}"
            }
          },
          "resource": {
            "digitalocean_ssh_key": {
              "machine": {
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "example",
                "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
              }
            }
          }
        }
      },
