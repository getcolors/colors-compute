            "protocol": "tcp",
            "source_addresses": [
              "192.0.2.1/32"
            ]
          }
        },
        "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors",
        "region": "nyc3"
      },
      "provider": "digitalocean",
      "stage": "shared-created-keygen"
