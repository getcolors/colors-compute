[
  {
    "name": "vultr public singleton no private network",
    "op": "plan_deployment",
    "args": [
      {
        "compute-prevent-destroy": true,
        "profile": "example",
        "provider-compute": "vultr",
        "vultr-os-id": 2284,
        "vultr-plan": "vc2-2c-4gb",
        "vultr-region": "ewr"
      },
      [
        {
          "count": 1
        }
      ],
      {
        "single_host": true,
        "private": false,
        "security": {
          "egress": "all",
          "private_filter": false,
          "ingress": [
            {
              "id": "ssh",
              "protocol": "tcp",
              "from_port": 22,
              "to_port": 22,
              "sources": [
                "192.0.2.1/32",
                "::/0"
              ]
            }
          ]
        }
      }
    ],
    "expected": {
      "status": "planned",
      "documents": {
        "shared": {
          "shared-keygen.tf.json": {
            "output": {
              "registration": {
                "value": {
                  "id": "${vultr_ssh_key.machine.id}",
                  "provider": "vultr",
                  "scope": "account"
                }
              },
              "ssh_key_id": {
                "value": "${vultr_ssh_key.machine.id}"
              }
            },
            "resource": {
              "vultr_ssh_key": {
                "machine": {
                  "lifecycle": {
                    "prevent_destroy": true
                  },
                  "name": "example",
                  "ssh_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
                }
              }
            }
          },
          "shared-none.tf.json": {
            "locals": {
              "ingress": {
                "ssh:192.0.2.1/32": {
                  "protocol": "tcp",
                  "port": "22",
                  "ip_type": "v4",
                  "subnet": "192.0.2.1",
                  "subnet_size": 32
                },
                "ssh:::/0": {
                  "protocol": "tcp",
                  "port": "22",
                  "ip_type": "v6",
                  "subnet": "::",
                  "subnet_size": 0
                }
              }
            },
            "output": {
              "params": {
                "value": {
                  "firewall_group_id": "${vultr_firewall_group.network.id}",
                  "provider": "vultr"
                }
              }
            },
            "provider": {
              "vultr": {}
            },
            "resource": {
              "vultr_firewall_group": {
                "network": {
                  "description": "example-firewall",
                  "lifecycle": {
                    "prevent_destroy": true
                  }
                }
              },
              "vultr_firewall_rule": {
                "ingress": {
                  "firewall_group_id": "${vultr_firewall_group.network.id}",
                  "for_each": "${local.ingress}",
                  "ip_type": "${each.value.ip_type}",
                  "port": "${each.value.port}",
                  "protocol": "${each.value.protocol}",
                  "subnet": "${each.value.subnet}",
                  "subnet_size": "${each.value.subnet_size}"
                }
              }
            },
            "terraform": {
              "required_providers": {
                "vultr": {
                  "source": "vultr/vultr",
                  "version": "2.32.0"
                }
              }
            }
          }
        },
        "nodes": {
          "0": {
            "node-none.tf.json": {
              "output": {
                "params": {
                  "value": {
                    "ip": "${vultr_instance.node.main_ip}",
                    "name": "${vultr_instance.node.label}",
                    "node_id": "0",
                    "provider": "vultr",
                    "provider_id": "${vultr_instance.node.id}",
                    "ssh_key_id": 12345,
                    "sudoer": "root",
                    "user": "root",
                    "vpc_ip": null
                  }
                }
              },
              "provider": {
                "vultr": {}
              },
              "resource": {
                "vultr_instance": {
                  "node": {
                    "firewall_group_id": "00000000-0000-0000-0000-000000000001",
                    "label": "example",
                    "lifecycle": {
                      "prevent_destroy": true
                    },
                    "os_id": 2284,
                    "plan": "vc2-2c-4gb",
                    "region": "ewr",
                    "ssh_key_ids": [
                      12345
                    ]
                  }
                }
              },
              "terraform": {
                "required_providers": {
                  "vultr": {
                    "source": "vultr/vultr",
                    "version": "2.32.0"
                  }
                }
              }
            }
          }
        }
      },
      "shared": {
        "key_name": "example",
        "params": {
          "firewall_group_id": "00000000-0000-0000-0000-000000000001",
          "firewall_id": 12345,
          "nsg_ids": [
            "nsg-fixture"
          ],
          "provider": "vultr",
          "security_group_id": "security-fixture",
          "subnetwork_id": "subnetwork-fixture"
        },
        "ssh_key_id": 12345
      },
      "state_keys": {
        "shared": "example/compute/shared.tfstate",
        "nodes": {
          "0": "example/compute/nodes/0.tfstate"
        }
      },
      "cluster": {
        "provider": "vultr",
        "entry_node_id": "0",
        "nodes": [
          {
            "provider_id": "planned-vultr-0",
            "node_id": "0",
            "provider": "vultr",
            "name": "example",
            "ip": "192.0.2.10",
            "vpc_ip": null,
            "user": "root",
            "sudoer": "root",
            "ssh_identity_file": "$HOME/.ssh/example",
            "role": null,
            "index": 0
          }
        ]
      },
      "key": {
        "mode": "managed",
        "private_key_path": "$HOME/.ssh/example"
      }
    }
  },
  {
    "name": "vultr none refuses private",
    "op": "plan_deployment",
    "args": [
      {
        "compute-prevent-destroy": true,
        "profile": "example",
        "provider-compute": "vultr",
        "vultr-os-id": 2284,
        "vultr-plan": "vc2-2c-4gb",
        "vultr-region": "ewr"
      },
      [
        {
          "count": 1
        }
      ],
      {
        "single_host": true,
        "private": true,
        "security": {
          "egress": "all",
          "private_filter": false,
          "ingress": [
            {
              "id": "ssh",
              "protocol": "tcp",
              "from_port": 22,
              "to_port": 22,
              "sources": [
                "192.0.2.1/32",
                "::/0"
              ]
            }
          ]
        },
        "network": {
          "mode": "none"
        }
      }
    ],
    "expected": {
      "error": "network none requires public-only single host"
    }
  },
