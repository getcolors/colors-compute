                    "enp00000000000000000"
                  ],
                  "subnet_id": "e9b00000000000000000",
                  "zone": "ru-central1-a"
                },
                "name": "${yandex_compute_instance.node.name}",
                "node_id": "0",
                "provider": "yandex",
                "provider_id": "${yandex_compute_instance.node.id}",
                "sudoer": "ubuntu",
                "user": "ubuntu",
                "vpc_ip": "${yandex_compute_instance.node.network_interface[0].ip_address}"
              }
            }
          },
          "provider": {
            "yandex": {
              "cloud_id": "b1g00000000000000000",
              "folder_id": "b1g00000000000000001",
              "zone": "ru-central1-a"
            }
          },
          "resource": {
            "yandex_compute_instance": {
              "node": {
                "allow_stopping_for_update": false,
                "boot_disk": [
                  {
                    "initialize_params": [
                      {
                        "image_id": "fd800000000000000000",
                        "size": 20
                      }
                    ]
                  }
                ],
                "lifecycle": {
                  "prevent_destroy": true
                },
                "metadata": {
                  "ssh-keys": "ubuntu:${trimspace(local.public_key)}"
                },
                "name": "example-0",
                "network_interface": [
                  {
                    "nat": true,
                    "nat_ip_address": "${yandex_vpc_address.node.external_ipv4_address[0].address}",
                    "security_group_ids": [
                      "enp00000000000000000"
                    ],
                    "subnet_id": "e9b00000000000000000"
                  }
                ],
                "platform_id": "standard-v3",
                "resources": [
                  {
                    "core_fraction": 100,
                    "cores": 2,
                    "memory": 4
                  }
                ],
                "zone": "ru-central1-a"
              }
            },
            "yandex_vpc_address": {
              "node": {
                "external_ipv4_address": [
                  {
                    "zone_id": "ru-central1-a"
                  }
                ],
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "example-0"
              }
            }
          },
          "terraform": {
            "required_providers": {
              "yandex": {
                "source": "yandex-cloud/yandex",
                "version": "0.120.0"
              }
            }
          }
        }
      },
      "inputs": {
        "allow_stopping_for_update": false,
        "cloud_id": "b1g00000000000000000",
        "core_fraction": 100,
        "cores": 2,
        "disk_size": 20,
        "folder_id": "b1g00000000000000001",
        "image_id": "fd800000000000000000",
        "memory": 4,
        "name": "example-0",
        "node_id": "0",
        "platform_id": "standard-v3",
        "prevent_destroy": true,
        "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors",
        "security_group_ids": [
          "enp00000000000000000"
        ],
        "subnet_id": "e9b00000000000000000",
        "zone": "ru-central1-a"
      },
      "provider": "yandex",
