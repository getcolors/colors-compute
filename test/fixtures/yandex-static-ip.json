      },
      "node",
      {
        "key": {
          "mode": "managed",
          "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
        },
        "name": "example-0",
        "network": {
          "cidr": "10.42.0.0/16",
          "mode": "created",
          "subnet_cidr": "10.42.1.0/24",
          "zone": "eu-central"
        },
        "node_id": "0",
        "security": {
          "egress": "all",
