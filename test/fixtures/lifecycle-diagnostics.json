[
  {
    "name": "safe lifecycle diagnostic missing-tool",
    "op": "lifecycle_diagnostic",
    "args": [
      "missing-tool",
      [
        "tofu",
        "aws",
        "tofu",
        "PRIVATE"
      ]
    ],
    "expected": {
      "status": "error",
      "errors": [
        "Required infrastructure tools are missing from PATH. Missing: aws, tofu. Next: Install the listed tools or load the deployment environment, then retry."
