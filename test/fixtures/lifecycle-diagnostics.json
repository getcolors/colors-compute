      "diagnostics": [
        {
          "code": "missing-tool",
          "message": "Required infrastructure tools are missing from PATH.",
          "hint": "Install the listed tools or load the deployment environment, then retry.",
          "tools": [
            "aws",
            "tofu"
          ]
        }
      ]
    }
  },
