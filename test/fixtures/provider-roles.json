[
  {
    "args": [
      {
        "compute-prevent-destroy": true,
        "profile": "example",
        "provider-compute": "vultr",
        "vultr-os-id": 2284,
        "vultr-plan": "vc2-2c-4gb",
        "vultr-region": "ewr"
      },
      "shared",
      {
        "key": {
          "mode": "managed",
          "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
        },
        "name": "example",
        "network": {
          "cidr": "10.42.0.0/16",
          "mode": "created",
          "subnet_cidr": "10.42.1.0/24",
          "zone": "eu-central"
        },
        "node_id": "shared",
        "roles": {
          "app": {
            "security": {
              "egress": "all",
              "ingress": [
                {
                  "from_port": 22,
                  "id": "ssh",
                  "protocol": "tcp",
                  "sources": [
                    "192.0.2.0/24"
                  ],
                  "to_port": 22
                }
              ],
              "private_filter": true
            }
          },
          "db": {
            "security": {
              "egress": "all",
              "ingress": [
                {
                  "from_port": 22,
                  "id": "ssh",
                  "protocol": "tcp",
                  "sources": [
                    "192.0.2.0/24"
                  ],
                  "to_port": 22
                },
                {
                  "from_port": 5432,
                  "id": "db",
                  "peer_roles": [
                    "app"
                  ],
                  "protocol": "tcp",
                  "to_port": 5432
                }
              ],
              "private_filter": true
            }
          }
        },
        "security": {
          "egress": "all",
          "ingress": [
            {
              "from_port": 22,
