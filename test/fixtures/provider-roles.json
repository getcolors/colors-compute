            }
          ],
          "private_filter": true
        }
      }
    ],
    "expected": {
      "documents": {
        "shared-keygen.tf.json": {
          "output": {
            "registration": {
              "value": {
                "id": "${vultr_ssh_key.machine.id}",
                "provider": "vultr",
                "scope": "account"
              }
            },
            "ssh_key_id": {
              "value": "${vultr_ssh_key.machine.id}"
            }
          },
          "resource": {
            "vultr_ssh_key": {
              "machine": {
                "lifecycle": {
                  "prevent_destroy": true
                },
                "name": "example",
                "ssh_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
              }
            }
          }
        },
        "shared-roles.tf.json": {
          "locals": {
            "ingress": {
              "app:ssh:192.0.2.0/24": {
                "ip_type": "v4",
                "port": "22",
                "protocol": "tcp",
                "role": "app",
                "subnet": "192.0.2.0",
                "subnet_size": 24
              },
              "db:ssh:192.0.2.0/24": {
                "ip_type": "v4",
                "port": "22",
                "protocol": "tcp",
                "role": "db",
                "subnet": "192.0.2.0",
                "subnet_size": 24
              }
            }
          },
          "output": {
            "params": {
              "value": {
                "network_cidr": "${vultr_vpc.network.v4_subnet}/${vultr_vpc.network.v4_subnet_mask}",
                "provider": "vultr",
                "role_firewall_ids": "${ { for role, firewall in vultr_firewall_group.role : role => firewall.id } }",
                "vpc_id": "${vultr_vpc.network.id}",
                "vpc_ip_range": "10.42.0.0/16"
              }
            }
          },
          "provider": {
            "vultr": {}
          },
          "resource": {
            "vultr_firewall_group": {
              "role": {
                "description": "${each.value}",
                "for_each": {
                  "app": "example-app-firewall",
                  "db": "example-db-firewall"
                },
                "lifecycle": {
                  "prevent_destroy": true
                }
              }
            },
            "vultr_firewall_rule": {
              "ingress": {
                "firewall_group_id": "${vultr_firewall_group.role[each.value.role].id}",
                "for_each": "${local.ingress}",
                "ip_type": "${each.value.ip_type}",
                "port": "${each.value.port}",
                "protocol": "${each.value.protocol}",
                "subnet": "${each.value.subnet}",
                "subnet_size": "${each.value.subnet_size}"
              }
            },
            "vultr_vpc": {
              "network": {
                "description": "example",
                "lifecycle": {
                  "prevent_destroy": true
                },
                "region": "ewr",
                "v4_subnet": "10.42.0.0",
                "v4_subnet_mask": 16
              }
            }
          },
          "terraform": {
            "required_providers": {
              "vultr": {
                "source": "vultr/vultr",
                "version": "2.32.0"
              }
            }
          }
        }
      },
      "inputs": {
        "firewall_groups": {
          "app": "example-app-firewall",
          "db": "example-db-firewall"
        },
        "name": "example",
        "network_address": "10.42.0.0",
        "network_cidr": "10.42.0.0/16",
        "network_prefix": 16,
        "prevent_destroy": true,
        "profile": "example",
        "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors",
        "region": "ewr",
        "role_ingress": {
          "app:ssh:192.0.2.0/24": {
            "ip_type": "v4",
            "port": "22",
            "protocol": "tcp",
            "role": "app",
            "subnet": "192.0.2.0",
            "subnet_size": 24
          },
          "db:ssh:192.0.2.0/24": {
            "ip_type": "v4",
            "port": "22",
            "protocol": "tcp",
            "role": "db",
            "subnet": "192.0.2.0",
            "subnet_size": 24
          }
        }
      },
      "provider": "vultr",
      "stage": "shared-roles-keygen"
    },
    "name": "role-shared-initial",
