[
  {
    "name": "power already running",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "vultr"
      },
      "start",
      "12345678-1234-1234-1234-123456789abc",
      {
        "COLORS_PAR_VULTR_API_KEY": "synthetic-token"
      },
      [
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"running\", \"main_ip\": \"203.0.113.9\"}}"
      ]
    ],
    "expected": {
      "status": "ready",
      "ip": "203.0.113.9"
    }
  },
  {
    "name": "power start after polling",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "vultr"
      },
      "start",
      "12345678-1234-1234-1234-123456789abc",
      {
        "COLORS_PAR_VULTR_API_KEY": "synthetic-token"
      },
      [
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"stopped\", \"main_ip\": \"203.0.113.9\"}}",
        "",
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"stopped\", \"main_ip\": \"203.0.113.9\"}}",
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"running\", \"main_ip\": \"203.0.113.9\"}}"
      ]
    ],
    "expected": {
      "status": "ready",
      "ip": "203.0.113.9"
    }
  },
  {
    "name": "power stop",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "vultr"
      },
      "stop",
      "12345678-1234-1234-1234-123456789abc",
      {
        "COLORS_PAR_VULTR_API_KEY": "synthetic-token"
      },
      [
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"running\", \"main_ip\": \"203.0.113.9\"}}",
        "",
        "{\"instance\": {\"id\": \"12345678-1234-1234-1234-123456789abc\", \"power_status\": \"stopped\", \"main_ip\": \"203.0.113.9\"}}"
      ]
    ],
    "expected": {
      "status": "ready"
    }
  },
  {
    "name": "power wrong identity",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "vultr"
      },
      "start",
      "12345678-1234-1234-1234-123456789abc",
      {
        "COLORS_PAR_VULTR_API_KEY": "synthetic-token"
      },
      [
        "{\"instance\": {\"id\": \"other\", \"power_status\": \"running\", \"main_ip\": \"203.0.113.9\"}}"
      ]
    ],
    "expected": {
      "error": "compute power refused"
    }
  },
  {
    "name": "power malformed JSON",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "vultr"
      },
      "start",
      "12345678-1234-1234-1234-123456789abc",
      {
        "COLORS_PAR_VULTR_API_KEY": "synthetic-token"
      },
      [
        "{"
      ]
    ],
    "expected": {
      "error": "compute power refused"
    }
  },
