  {
    "name": "power OCI soft stop",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "oci",
        "oci-config-file-profile": "OPERATOR"
      },
      "stop",
      "ocid1.instance.oc1.example",
      {},
      [
        {
          "exit": 0,
          "out": "{\"data\": {\"id\": \"ocid1.instance.oc1.example\", \"lifecycle-state\": \"RUNNING\"}}"
        },
        {
          "exit": 0,
          "out": "{\"data\": {\"id\": \"ocid1.instance.oc1.example\", \"lifecycle-state\": \"STOPPED\"}}"
        },
        {
          "exit": 0,
          "out": "{\"data\": {\"id\": \"ocid1.instance.oc1.example\", \"lifecycle-state\": \"STOPPED\"}}"
        }
      ]
    ],
    "expected": {
      "status": "ready"
    }
  },
  {
    "name": "power OCI nonzero exit",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "oci",
        "oci-config-file-profile": "OPERATOR"
      },
      "stop",
      "ocid1.instance.oc1.example",
      {},
      [
        {
          "exit": -1,
          "out": "secret diagnostic"
        }
      ]
    ],
    "expected": {
      "error": "compute power refused"
    }
  },
  {
    "name": "power OCI profile bound secret",
    "op": "provider_power_case",
    "args": [
      {
        "provider-compute": "oci",
        "oci-config-file-profile": "OPERATOR"
      },
      "stop",
      "ocid1.instance.oc1.example",
      {
        "COLORS_PAR_VULTR_API_KEY": "OPERATOR"
      },
      []
    ],
    "expected": {
      "error": "compute power refused"
    }
  }
]
