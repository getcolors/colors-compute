{
  "terraform": {
    "required_providers": {
      "vultr": {
        "source": "vultr/vultr",
        "version": "2.32.0"
      }
    }
  },
  "provider": {
    "vultr": {}
  },
  "locals": {
    "ingress": "{{ingress}}"
  },
  "resource": {
    "vultr_firewall_group": {
      "network": {
        "description": "{{firewall_name}}",
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    },
    "vultr_firewall_rule": {
      "ingress": {
        "for_each": "${local.ingress}",
        "firewall_group_id": "${vultr_firewall_group.network.id}",
        "protocol": "${each.value.protocol}",
        "port": "${each.value.port}",
        "ip_type": "${each.value.ip_type}",
        "subnet": "${each.value.subnet}",
        "subnet_size": "${each.value.subnet_size}"
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "vultr",
        "firewall_group_id": "${vultr_firewall_group.network.id}"
      }
    }
  }
}
