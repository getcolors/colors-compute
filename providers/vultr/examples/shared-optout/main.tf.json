{
  "terraform": {
    "required_providers": {
      "vultr": {
        "source": "vultr/vultr",
        "version": "2.32.0"
      }
    }
  },
  "provider": {
    "vultr": {}
  },
  "locals": {
    "ingress": {
      "ssh:192.0.2.1/32": {
        "protocol": "tcp",
        "port": "22",
        "ip_type": "v4",
        "subnet": "192.0.2.1",
        "subnet_size": 32
      },
      "kafka:192.0.2.1/32": {
        "protocol": "tcp",
        "port": "9092",
        "ip_type": "v4",
        "subnet": "192.0.2.1",
        "subnet_size": 32
      },
      "cluster_internal:9093": {
        "protocol": "tcp",
        "port": "9093",
        "ip_type": "v4",
        "subnet": "10.42.0.0",
        "subnet_size": 24
      },
      "cluster_internal:9094": {
        "protocol": "tcp",
        "port": "9094",
        "ip_type": "v4",
        "subnet": "10.42.0.0",
        "subnet_size": 24
      }
    }
  },
  "resource": {
    "vultr_vpc": {
      "network": {
        "region": "ewr",
        "description": "example",
        "v4_subnet": "10.42.0.0",
        "v4_subnet_mask": 24,
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "vultr_firewall_group": {
      "network": {
        "description": "example-firewall",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "vultr_firewall_rule": {
      "ingress": {
        "for_each": "${local.ingress}",
        "firewall_group_id": "${vultr_firewall_group.network.id}",
        "protocol": "${each.value.protocol}",
        "port": "${each.value.port}",
        "ip_type": "${each.value.ip_type}",
        "subnet": "${each.value.subnet}",
        "subnet_size": "${each.value.subnet_size}"
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "vultr",
        "vpc_id": "${vultr_vpc.network.id}",
        "vpc_ip_range": "10.42.0.0/24",
        "firewall_group_id": "${vultr_firewall_group.network.id}",
        "network_cidr": "${vultr_vpc.network.v4_subnet}/${vultr_vpc.network.v4_subnet_mask}"
      }
    }
  }
}
