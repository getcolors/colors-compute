{
  "terraform": {
    "required_version": ">= 1.8.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "6.31.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "eu-west-1"
    }
  },
  "resource": {
    "aws_vpc": {
      "network": {
        "cidr_block": "10.42.0.0/16",
        "enable_dns_hostnames": true,
        "enable_dns_support": true,
        "tags": {
          "Name": "example-broker-0"
        }
      }
    },
    "aws_subnet": {
      "public": {
        "vpc_id": "${aws_vpc.network.id}",
        "cidr_block": "10.42.1.0/24",
        "availability_zone": "eu-west-1a",
        "map_public_ip_on_launch": true,
        "tags": {
          "Name": "example-broker-0"
        }
      }
    },
    "aws_internet_gateway": {
      "gateway": {
        "vpc_id": "${aws_vpc.network.id}",
        "tags": {
          "Name": "example-broker-0"
        }
      }
    },
    "aws_route_table": {
      "public": {
        "vpc_id": "${aws_vpc.network.id}",
        "tags": {
          "Name": "example-broker-0"
        }
      }
    },
    "aws_route": {
      "internet": {
        "route_table_id": "${aws_route_table.public.id}",
        "destination_cidr_block": "0.0.0.0/0",
        "gateway_id": "${aws_internet_gateway.gateway.id}"
      }
    },
    "aws_route_table_association": {
      "public": {
        "subnet_id": "${aws_subnet.public.id}",
        "route_table_id": "${aws_route_table.public.id}"
      }
    },
    "aws_security_group": {
      "role": {
        "for_each": {
          "app": "example-app-firewall",
          "db": "example-db-firewall"
        },
        "name": "${each.value}",
        "description": "Deployment role access",
        "vpc_id": "${aws_vpc.network.id}",
        "tags": {
          "Name": "${each.value}"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "ingress": {
        "for_each": {
          "app:ssh:192.0.2.0/24": {
            "role": "app",
            "protocol": "tcp",
            "from_port": 22,
            "to_port": 22,
            "cidr": "192.0.2.0/24"
          },
          "db:postgres:peer:app-0": {
            "role": "db",
            "protocol": "tcp",
            "from_port": 5432,
            "to_port": 5432,
            "cidr": "10.42.1.5/32"
          }
        },
        "security_group_id": "${aws_security_group.role[each.value.role].id}",
        "cidr_ipv4": "${each.value.cidr}",
        "ip_protocol": "${each.value.protocol}",
        "from_port": "${each.value.from_port}",
        "to_port": "${each.value.to_port}"
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "egress": {
        "for_each": {
          "app": "example-app-firewall",
          "db": "example-db-firewall"
        },
        "security_group_id": "${aws_security_group.role[each.key].id}",
        "ip_protocol": "-1",
        "cidr_ipv4": "0.0.0.0/0"
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "aws",
        "vpc_id": "${aws_vpc.network.id}",
        "subnet_id": "${aws_subnet.public.id}",
        "network_cidr": "${aws_vpc.network.cidr_block}",
        "role_firewall_ids": "${ { for role, group in aws_security_group.role : role => group.id } }"
      }
    }
  }
}
