{
  "resource": {
    "hcloud_ssh_key": {
      "machine": {
        "name": "example",
        "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "ssh_key_id": {
      "value": "${hcloud_ssh_key.machine.id}"
    }
  }
}
