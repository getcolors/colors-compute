{
  "terraform": {
    "required_providers": {
      "hcloud": {
        "source": "hetznercloud/hcloud",
        "version": "1.54.0"
      }
    }
  },
  "provider": {
    "hcloud": {}
  },
  "resource": {
    "hcloud_network": {
      "network": {
        "name": "example-network",
        "ip_range": "10.42.0.0/16",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "hcloud_network_subnet": {
      "network": {
        "network_id": "${hcloud_network.network.id}",
        "type": "cloud",
        "network_zone": "eu-central",
        "ip_range": "10.42.1.0/24",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "hcloud_firewall": {
      "network": {
        "name": "example-firewall",
        "rule": [
          {
            "direction": "in",
            "protocol": "tcp",
            "port": "22",
            "source_ips": [
              "192.0.2.1/32"
            ]
          },
          {
            "direction": "in",
            "protocol": "udp",
            "port": "51820",
            "source_ips": [
              "192.0.2.1/32"
            ]
          },
          {
            "direction": "in",
            "protocol": "icmp",
            "source_ips": [
              "192.0.2.1/32"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "hcloud",
        "vpc_id": "${hcloud_network.network.id}",
        "vpc_ip_range": "${hcloud_network.network.ip_range}",
        "subnet_id": "${hcloud_network_subnet.network.id}",
        "subnet_cidr": "${hcloud_network_subnet.network.ip_range}",
        "firewall_id": "${hcloud_firewall.network.id}",
        "network_cidr": "${hcloud_network.network.ip_range}"
      }
    }
  }
}
