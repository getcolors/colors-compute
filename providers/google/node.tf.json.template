{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "6.0.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "{{project}}",
      "region": "{{region}}",
      "zone": "{{zone}}"
    }
  },
  "locals": {
    "public_key": "{{public_key}}"
  },
  "resource": {
    "google_compute_address": {
      "node": {
        "name": "{{name}}",
        "region": "{{region}}",
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    },
    "google_compute_instance": {
      "node": {
        "name": "{{name}}",
        "machine_type": "{{machine_type}}",
        "zone": "{{zone}}",
        "tags": [
          "{{network_tag}}"
        ],
        "boot_disk": [
          {
            "initialize_params": [
              {
                "image": "{{image}}",
                "size": "{{boot_disk_size}}",
                "type": "pd-balanced"
              }
            ]
          }
        ],
        "network_interface": [
          {
            "subnetwork": "{{subnetwork_id}}",
            "access_config": [
              {
                "nat_ip": "${google_compute_address.node.address}"
              }
            ]
          }
        ],
        "metadata": {
          "ssh-keys": "ubuntu:${trimspace(local.public_key)}",
          "block-project-ssh-keys": "true",
          "enable-oslogin": "false"
        },
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "node_id": "{{node_id}}",
        "provider": "google",
        "name": "${google_compute_instance.node.name}",
        "ip": "${google_compute_address.node.address}",
        "vpc_ip": "${google_compute_instance.node.network_interface[0].network_ip}",
        "user": "ubuntu",
        "sudoer": "ubuntu",
        "metadata": {
          "instance_id": "${google_compute_instance.node.instance_id}",
          "self_link": "${google_compute_instance.node.self_link}",
          "subnetwork_id": "{{subnetwork_id}}",
          "zone": "{{zone}}",
          "address_id": "${google_compute_address.node.id}"
        },
        "provider_id": "${google_compute_instance.node.id}"
      }
    }
  }
}
