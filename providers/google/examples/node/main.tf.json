{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "6.0.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "colors-example-project",
      "region": "europe-west1",
      "zone": "europe-west1-b"
    }
  },
  "locals": {
    "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors"
  },
  "resource": {
    "google_compute_address": {
      "node": {
        "name": "example-0",
        "region": "europe-west1",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "google_compute_instance": {
      "node": {
        "name": "example-0",
        "machine_type": "e2-medium",
        "zone": "europe-west1-b",
        "tags": [
          "example-network"
        ],
        "boot_disk": [
          {
            "initialize_params": [
              {
                "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts",
                "size": 20,
                "type": "pd-balanced"
              }
            ]
          }
        ],
        "network_interface": [
          {
            "subnetwork": "projects/colors-example-project/regions/europe-west1/subnetworks/example-network",
            "access_config": [
              {
                "nat_ip": "${google_compute_address.node.address}"
              }
            ]
          }
        ],
        "metadata": {
          "ssh-keys": "ubuntu:${trimspace(local.public_key)}",
          "block-project-ssh-keys": "true",
          "enable-oslogin": "false"
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "node_id": "0",
        "provider": "google",
        "name": "${google_compute_instance.node.name}",
        "ip": "${google_compute_address.node.address}",
        "vpc_ip": "${google_compute_instance.node.network_interface[0].network_ip}",
        "user": "ubuntu",
        "sudoer": "ubuntu",
        "metadata": {
          "instance_id": "${google_compute_instance.node.instance_id}",
          "self_link": "${google_compute_instance.node.self_link}",
          "subnetwork_id": "projects/colors-example-project/regions/europe-west1/subnetworks/example-network",
          "zone": "europe-west1-b",
          "address_id": "${google_compute_address.node.id}"
        }
      }
    }
  }
}
