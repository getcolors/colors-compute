{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "6.0.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "colors-example-project",
      "region": "europe-west1",
      "zone": "europe-west1-b"
    }
  },
  "locals": {
    "ingress": {
      "ssh": {
        "name": "example-ssh",
        "protocol": "tcp",
        "ports": [
          "22"
        ],
        "source_ranges": [
          "192.0.2.1/32"
        ]
      },
      "cluster": {
        "name": "example-cluster",
        "protocol": "tcp",
        "ports": [
          "9093",
          "9094"
        ],
        "source_ranges": [
          "10.42.0.0/24"
        ]
      }
    }
  },
  "resource": {
    "google_compute_network": {
      "network": {
        "name": "example-network",
        "auto_create_subnetworks": false,
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "google_compute_subnetwork": {
      "network": {
        "name": "example-network",
        "region": "europe-west1",
        "network": "${google_compute_network.network.id}",
        "ip_cidr_range": "10.42.0.0/24",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "google_compute_firewall": {
      "ingress": {
        "for_each": "${local.ingress}",
        "name": "${each.value.name}",
        "network": "${google_compute_network.network.id}",
        "direction": "INGRESS",
        "source_ranges": "${each.value.source_ranges}",
        "target_tags": [
          "example-network"
        ],
        "allow": [
          {
            "protocol": "${each.value.protocol}",
            "ports": "${each.value.ports}"
          }
        ]
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "google",
        "network_id": "${google_compute_network.network.id}",
        "subnetwork_id": "${google_compute_subnetwork.network.id}",
        "network_tag": "example-network",
        "network_cidr": "${google_compute_subnetwork.network.ip_cidr_range}",
        "firewall_ids": "${ {for key, rule in google_compute_firewall.ingress : key => rule.id} }"
      }
    }
  }
}
