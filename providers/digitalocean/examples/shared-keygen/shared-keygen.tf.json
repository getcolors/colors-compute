{
  "resource": {
    "digitalocean_ssh_key": {
      "machine": {
        "name": "example",
        "public_key": "ssh-ed25519 PLACEHOLDER managed-by-colors",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "ssh_key_id": {
      "value": "${digitalocean_ssh_key.machine.id}"
    },
    "registration": {
      "value": {
        "provider": "digitalocean",
        "scope": "account",
        "id": "${digitalocean_ssh_key.machine.id}"
      }
    }
  }
}
