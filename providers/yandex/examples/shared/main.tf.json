{
  "terraform": {
    "required_providers": {
      "yandex": {
        "source": "yandex-cloud/yandex",
        "version": "0.120.0"
      }
    }
  },
  "provider": {
    "yandex": {
      "cloud_id": "b1g00000000000000000",
      "folder_id": "b1g00000000000000001",
      "zone": "ru-central1-a"
    }
  },
  "locals": {
    "ingress": {
      "ssh": {
        "protocol": "TCP",
        "from_port": 22,
        "to_port": 22,
        "cidr_blocks": [
          "192.0.2.1/32"
        ]
      },
      "cluster": {
        "protocol": "TCP",
        "from_port": 9093,
        "to_port": 9094,
        "cidr_blocks": [
          "10.42.0.0/24"
        ]
      }
    },
    "egress": {
      "outbound": {
        "protocol": "ANY",
        "from_port": 0,
        "to_port": 65535,
        "cidr_blocks": [
          "0.0.0.0/0"
        ]
      }
    }
  },
  "resource": {
    "yandex_vpc_network": {
      "network": {
        "name": "example-network",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "yandex_vpc_subnet": {
      "network": {
        "name": "example-network",
        "zone": "ru-central1-a",
        "network_id": "${yandex_vpc_network.network.id}",
        "v4_cidr_blocks": [
          "10.42.0.0/24"
        ],
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "yandex_vpc_security_group": {
      "network": {
        "name": "example-network",
        "network_id": "${yandex_vpc_network.network.id}",
        "dynamic": {
          "ingress": {
            "for_each": "${local.ingress}",
            "content": {
              "description": "${ingress.key}",
              "protocol": "${ingress.value.protocol}",
              "from_port": "${ingress.value.from_port}",
              "to_port": "${ingress.value.to_port}",
              "v4_cidr_blocks": "${ingress.value.cidr_blocks}"
            }
          },
          "egress": {
            "for_each": "${local.egress}",
            "content": {
              "description": "${egress.key}",
              "protocol": "${egress.value.protocol}",
              "from_port": "${egress.value.from_port}",
              "to_port": "${egress.value.to_port}",
              "v4_cidr_blocks": "${egress.value.cidr_blocks}"
            }
          }
        },
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "provider": "yandex",
        "network_id": "${yandex_vpc_network.network.id}",
        "subnet_id": "${yandex_vpc_subnet.network.id}",
        "security_group_id": "${yandex_vpc_security_group.network.id}",
        "network_cidr": "10.42.0.0/24",
        "zone": "ru-central1-a"
      }
    }
  }
}
