{
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "4.30.0"
      }
    }
  },
  "provider": {
    "azurerm": {
      "subscription_id": "{{subscription_id}}",
      "features": {}
    }
  },
  "resource": {
    "azurerm_public_ip": {
      "node": {
        "name": "{{public_ip_name}}",
        "location": "{{location}}",
        "resource_group_name": "{{resource_group_name}}",
        "allocation_method": "Static",
        "sku": "Standard",
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    },
    "azurerm_network_interface": {
      "node": {
        "name": "{{nic_name}}",
        "location": "{{location}}",
        "resource_group_name": "{{resource_group_name}}",
        "ip_configuration": {
          "name": "primary",
          "subnet_id": "{{subnet_id}}",
          "private_ip_address_allocation": "Dynamic",
          "public_ip_address_id": "${azurerm_public_ip.node.id}"
        },
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    },
    "azurerm_linux_virtual_machine": {
      "node": {
        "name": "{{name}}",
        "location": "{{location}}",
        "resource_group_name": "{{resource_group_name}}",
        "size": "{{vm_size}}",
        "admin_username": "ubuntu",
        "disable_password_authentication": true,
        "network_interface_ids": [
          "${azurerm_network_interface.node.id}"
        ],
        "admin_ssh_key": {
          "username": "ubuntu",
          "public_key": "{{public_key}}"
        },
        "source_image_reference": "{{image_reference}}",
        "os_disk": {
          "caching": "ReadWrite",
          "storage_account_type": "Standard_LRS",
          "disk_size_gb": "{{disk_size_gb}}"
        },
        "lifecycle": {
          "prevent_destroy": "{{prevent_destroy}}"
        }
      }
    }
  },
  "output": {
    "params": {
      "value": {
        "node_id": "{{node_id}}",
        "provider": "azure",
        "name": "${azurerm_linux_virtual_machine.node.name}",
        "ip": "${azurerm_public_ip.node.ip_address}",
        "vpc_ip": "${azurerm_network_interface.node.private_ip_address}",
        "vm_id": "${azurerm_linux_virtual_machine.node.id}",
        "nic_id": "${azurerm_network_interface.node.id}",
        "subnet_id": "{{subnet_id}}",
        "user": "ubuntu",
        "sudoer": "ubuntu",
        "ssh_key_id": null,
        "provider_id": "${azurerm_linux_virtual_machine.node.id}"
      }
    }
  }
}
